    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Links between the peers -->
    <path
        android:pathData="M54,34 L32,72 M54,34 L76,72 M32,72 L76,72"
        android:strokeWidth="6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Peer nodes -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,23a11,11 0 1,0 0,22a11,11 0 1,0 0,-22z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,61a11,11 0 1,0 0,22a11,11 0 1,0 0,-22z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M76,61a11,11 0 1,0 0,22a11,11 0 1,0 0,-22z" />
</vector>
